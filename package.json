{
  "name": "bot-front",
  "version": "1.0.0",
  "description": "Read-only web view of the trading bot's positions",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build:web": "tsx scripts/build-web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfreskgard/bot-front.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/kfreskgard/bot-front/issues"
  },
  "homepage": "https://github.com/kfreskgard/bot-front#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "acme-client": "^5.4.0",
    "hono": "^4.13.13",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}

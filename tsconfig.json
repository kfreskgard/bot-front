{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["shared", "src", "test", "scripts"],
  "exclude": ["web"]
}
